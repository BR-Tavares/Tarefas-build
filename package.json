{
  "name": "tarefas-build",
  "version": "1.0.0",
  "description": "App de missões (PWA) — Protocolo de missões v2.7 no Firebase",
  "type": "module",
  "scripts": {
    "test:analise": "node --test test/analise.test.js",
    "test:missao": "node --test test/redigir-missao.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore.rules.test.js\"",
    "test": "npm run test:analise && npm run test:missao && npm run test:rules",
    "deploy:hosting": "firebase deploy --only hosting,firestore:rules",
    "deploy:all": "firebase deploy"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.1"
  }
}
